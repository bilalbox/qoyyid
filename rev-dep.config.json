{
	"configVersion": "2.2",
	"$schema": "https://github.com/jayu/rev-dep/blob/master/config-schema/2.2.schema.json?raw=true",
	"baselineSnapshotPath": ".rev-dep.baseline.json",
	"ignoreFiles": [
		"**/node_modules/**",
		"**/dist/**",
		"**/.git/**",
		"**/.wrangler/**",
		"**/.svelte-kit/**",
		"**/baselines/**",
		"**/tests/ratchets/fixtures/**",
		"**/static/**",
		"**/worker-configuration.d.ts"
	],
	"nodeModulesResolution": {
		"resolutionType": "entry-package",
		"includeDevDepsFromRoot": false
	},
	"workspaces": [
		{
			"path": ".",
			"prodEntryPoints": ["src/**/*.{ts,tsx,svelte}"],
			"devEntryPoints": [
				"vite.config.ts",
				"vitest.config.ts",
				"scripts/**/*.{ts,tsx,js,mjs,cjs}",
				"tests/**/*.{ts,tsx,js,mjs,cjs,sh}"
			],
			"circularImportsDetection": {
				"enabled": true,
				"ignoreTypeImports": true
			},
			"orphanFilesDetection": {
				"enabled": true,
				"ignoreTypeImports": true,
				"graphExclude": ["scripts/**", "tests/**", "baselines/**"]
			},
			"unusedExportsDetection": {
				"enabled": true,
				"ignoreTypeExports": true,
				"ignoreFiles": ["scripts/**", "tests/**"]
			},
			"unusedNodeModulesDetection": {
				"enabled": true,
				"excludeModules": ["@types/**"],
				"pkgJsonFieldsWithBinaries": ["scripts", "bin"],
				"filesWithBinaries": [
					"scripts/run-rev-dep.ts",
					".husky/pre-commit",
					".husky/pre-push"
				],
				"filesWithModules": [
					"*.config.*",
					"biome.json",
					"biome.complexity.json",
					"vitest.config.*",
					"vite.config.*",
					"src/app.css"
				]
			},
			"missingNodeModulesDetection": {
				"enabled": true,
				"excludeModules": ["@types/**", "$app", "$app/**"]
			},
			"unresolvedImportsDetection": {
				"enabled": true
			},
			"devDepsUsageOnProdDetection": {
				"enabled": true,
				"ignoreTypeImports": true
			},
			"duplicatedCodeDetection": {
				"enabled": true,
				"minTokens": 50,
				"snapshotPath": ".rev-dep.duplicates.json",
				"ignoreFiles": ["scripts/**", "tests/**", "**/node_modules/**"]
			}
		}
	]
}
