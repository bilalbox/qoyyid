{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "qoyyid-orchestrator",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [{ "pattern": "qoyyid.23p.dev", "custom_domain": true }],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Serve index.html for any path that doesn't match a static file (SPA routing).
    "not_found_handling": "single-page-application",
    // Run the worker first for API routes so Hono handles them before asset lookup.
    "run_worker_first": ["/auth/*", "/jobs", "/jobs/*", "/admin", "/admin/*", "/health", "/me", "/me/*"],
  },
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "qoyyid-assets" }],
  "vars": {
    "R2_BUCKET_NAME": "qoyyid-assets",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "qoyyid-jobs",
      "database_id": "ecd441ba-d9e8-4fe0-ad08-58c3e68ae8da",
      "migrations_dir": "migrations",
    },
  ],
  "triggers": {
    "crons": ["*/5 * * * *"],
  },
  // Secrets: set via `npx wrangler secret put <NAME>`, or bulk-upload from
  // .env with `wrangler deploy --secrets-file=.env` (see .env.example).
  //   MISTRAL_API_KEY, GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, ADMIN_EMAILS,
  //   TURNSTILE_SECRET_KEY, FCM_SERVICE_ACCOUNT_JSON
}
