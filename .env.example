# Copy to .env and fill in (never commit .env).
#
# Used for local `wrangler dev` and to bulk-upload production secrets with
# `wrangler deploy --secrets-file=.env` (applies additively — omitted
# secrets are left alone, so this is safe to run repeatedly).

MISTRAL_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ADMIN_EMAILS=

# Cloudflare Turnstile (dashboard.cloudflare.com > Turnstile). Secret key is a
# Worker secret; site key is public and baked into the SPA build below.
TURNSTILE_SECRET_KEY=

# Firebase service account JSON for server-side FCM sends (Project settings >
# Service accounts > Generate new private key). Paste the whole JSON as a
# single line — wrangler secrets-file and D1/Workers env vars can't hold
# multi-line values.
FCM_SERVICE_ACCOUNT_JSON=

# --- Build-time public config (read by `vite build`, not Worker secrets) ---
# vite build --secrets-file uploads every key in this file as a Worker secret,
# so these VITE_ vars end up uploaded too; harmless (unused by the Worker) but
# expected — don't "fix" it by splitting into a second file.
VITE_TURNSTILE_SITE_KEY=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
