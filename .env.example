# Copy to .env and fill in (never commit .env).
#
# Used for local `wrangler dev` and to bulk-upload production secrets with
# `wrangler deploy --secrets-file=.env` (applies additively — omitted
# secrets are left alone, so this is safe to run repeatedly).

MISTRAL_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ADMIN_EMAILS=
