{
  "name": "qoyyid",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "build": "vite build",
    "deploy": "vite build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply qoyyid-jobs --local",
    "db:migrate:remote": "wrangler d1 migrations apply qoyyid-jobs --remote",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@oslojs/encoding": "^1.1.0",
    "arctic": "^3.7.0",
    "docx": "^9.5.0",
    "hono": "^4.12.27"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.68.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "svelte": "^5.56.4",
    "svelte-check": "^4.7.1",
    "typescript": "^5.8.3",
    "vite": "^8.0.0",
    "wrangler": "^4.20.0"
  }
}
